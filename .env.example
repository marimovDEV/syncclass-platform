# ==============================================================================
# SyncClass — muhit o'zgaruvchilari namunasi
# ------------------------------------------------------------------------------
#  Ishlatish:   cp .env.example .env   (yoki  make up  — o'zi nusxa oladi)
#  Manba:       docs/CONTRACTS.md §1 (yakuniy ro'yxat) + backend/app/core/config.py
#  Qoida:       SIRLAR bu faylda BO'SH. Haqiqiy kalitlarni faqat `.env` ga yoz.
#               `.env` git'ga tushmaydi (.gitignore).
#  Hostlar:     qiymatlar DOCKER COMPOSE ichida ishlash uchun (postgres, redis).
#               Backend'ni hostdan ishlatsang POSTGRES_HOST=localhost qil.
# ==============================================================================

# ------------------------------------------------- Docker HOST portlari ----
# Bular FAQAT `docker-compose.yml` uchun — backend/frontend kodi ularni o'qimaydi
# (shuning uchun CONTRACTS.md §1 ro'yxatida yo'q, infratuzilma o'zgaruvchilari).
# Mashinada port band bo'lsa SHU YERNI o'zgartir, compose faylga tegma.
# Konteynerlar o'zaro har doim ichki portlar bilan gaplashadi (80/3000/8000/5432/6379),
# shuning uchun bu qiymatlarni o'zgartirish ilova ishiga ta'sir qilmaydi.
#
# Ilovaning asosiy kirish nuqtasi (Nginx). Band bo'lsa: 8080
HOST_HTTP_PORT=80
# Frontend'ga to'g'ridan-to'g'ri (Nginx'ni chetlab, debug uchun)
HOST_FRONTEND_PORT=3000
# Backend'ga to'g'ridan-to'g'ri (Nginx'ni chetlab, debug uchun)
HOST_API_PORT=8000
# Lokal `psql` / DBeaver uchun. DIQQAT: bu pastdagi POSTGRES_PORT dan BOSHQA —
# POSTGRES_PORT konteyner ICHIDAGI port (backend shunga ulanadi, 5432 bo'lib qoladi).
HOST_POSTGRES_PORT=5432
# Lokal `redis-cli` uchun
HOST_REDIS_PORT=6379

# ------------------------------------------------------------------ Ilova ----
# development | staging | production
APP_ENV=development
# Ilova nomi (Swagger sarlavhasida ko'rinadi)
APP_NAME=SyncClass
# JWT imzolash kaliti. PRODUCTION'da ALBATTA almashtir: openssl rand -hex 32
SECRET_KEY=dev-only-insecure-secret-change-me
# JWT algoritmi (kontraktda faqat HS256 ruxsat etilgan)
JWT_ALGORITHM=HS256
# Access token muddati (daqiqa)
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token muddati (kun). DB da `jti` bilan saqlanadi, revoke qilinadi.
REFRESH_TOKEN_EXPIRE_DAYS=30
# CORS uchun ruxsat etilgan origin'lar (vergul bilan).
# Nginx 80-portda turgani uchun asosiysi http://localhost;
# 3000 — frontend'ni Nginx'siz ishlatganda kerak.
FRONTEND_ORIGIN=http://localhost,http://localhost:3000
# Backend'ning tashqi manzili (QR kod va OAuth URL'larini yasashda ishlatiladi)
BACKEND_PUBLIC_URL=http://localhost
# Log darajasi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------- PostgreSQL ----
# DB foydalanuvchisi
POSTGRES_USER=syncclass
# DB paroli (lokal dev uchun sodda; prod'da almashtir)
POSTGRES_PASSWORD=syncclass
# Baza nomi
POSTGRES_DB=syncclass
# Compose ichidagi servis nomi. Hostdan ishlatsang -> localhost
POSTGRES_HOST=postgres
# Konteyner ICHIDAGI port — backend shunga ulanadi, 5432 bo'lib qoladi.
# Host tomonidagi port esa yuqoridagi HOST_POSTGRES_PORT bilan boshqariladi.
POSTGRES_PORT=5432
# To'liq DSN. Bo'sh qoldirsang config.py yuqoridagi 5 ta qiymatdan o'zi yasaydi.
# Drayver ALBATTA asyncpg bo'lishi kerak (SQLAlchemy async).
DATABASE_URL=postgresql+asyncpg://syncclass:syncclass@postgres:5432/syncclass

# ------------------------------------------------------------------ Redis ----
# Room state (Hash), Pub/Sub, arq navbati, rate-limit va WS ticket'lar uchun.
#
# ⚠️ DIQQAT — oxiridagi DB RAQAMI (/0) ILOVAGA tegishli.
# Testlar o'z Redis DB sini `flushdb()` bilan TO'LIQ tozalaydi, shuning uchun
# `make test` MAJBURAN 15-DB da ishlaydi (Makefile da qattiq yozilgan, bu yerdan
# olinmaydi). Bu ikki raqam HECH QACHON teng bo'lmasligi kerak:
# aks holda dars ketayotganda `make test` desa — barcha jonli xonalarning holati
# (slayd indeksi, jonli kod, quiz, davomat) o'chib ketadi. Redis bu loyihada
# kesh emas, xona holatining YAGONA manbasi (AUDIT.md §B2).
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------- Google OAuth ----
# https://console.cloud.google.com -> APIs & Services -> Credentials
# "OAuth 2.0 Client ID" (Web application) yaratib, quyidagilarni to'ldir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google konsolidagi "Authorized redirect URI" bilan AYNAN bir xil bo'lishi shart
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/google/callback
# AUDIT.md §C1: FAQAT shu email'lar TEACHER bo'ladi. Vergul bilan ajratiladi.
# Bo'sh bo'lsa — hamma yangi foydalanuvchi STUDENT (xavfsiz default).
TEACHER_EMAIL_ALLOWLIST=

# ---------------------------------------------------------------- Storage ----
# Canonical (asosiy) manba: r2 | telegram. AUDIT.md §A1 bo'yicha r2 tavsiya etiladi.
STORAGE_PRIMARY=r2
# Cloudflare R2 — dashboard'dagi Account ID
R2_ACCOUNT_ID=
# R2 API token (S3-mos) kalitlari
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket nomi (R2 da qo'lda yaratib qo'yish kerak)
R2_BUCKET=syncclass-submissions
# S3 endpoint. Odatda: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Presigned download URL muddati (sekund). 900 = 15 daqiqa.
R2_PRESIGN_TTL_SEC=900

# Telegram — FAQAT zahira (best-effort, navbat orqali). Yoqish uchun true qil.
TELEGRAM_BACKUP_ENABLED=false
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=
# Zahira kanali ID (bot admin bo'lishi shart), masalan: -1001234567890
TELEGRAM_STORAGE_CHANNEL_ID=
# AUDIT.md §A1: Bot API `getFile` 20 MB dan kattasini QAYTARMAYDI — oshirma.
TELEGRAM_MAX_MB=20

# ------------------------------------------------------- Upload himoyasi ----
# Bitta topshiriq faylining maksimal hajmi (MB). Nginx 26m ga sozlangan.
MAX_UPLOAD_MB=25
# Bir vaqtda ishlov beriladigan upload soni (asyncio.Semaphore) — RAM himoyasi
MAX_CONCURRENT_UPLOADS=8
# AUDIT.md §A4 (zip-bomb): zip ichidagi maksimal fayl soni
ZIP_MAX_ENTRIES=500
# Zip ochilgandagi maksimal umumiy hajm (MB)
ZIP_MAX_UNCOMPRESSED_MB=20
# Maksimal siqish nisbati (ochilgan/siqilgan). 100 dan oshsa — zip-bomb.
ZIP_MAX_RATIO=100
# Bitta fayldan o'qiladigan maksimal belgi soni
EXTRACT_MAX_FILE_CHARS=200000
# Barcha fayllardan o'qiladigan jami maksimal belgi soni (TOAST bloat himoyasi)
EXTRACT_MAX_TOTAL_CHARS=1000000

# ----------------------------------------------------------- AI Pre-Grader ----
# Provayder (kontraktda faqat anthropic)
AI_PROVIDER=anthropic
# https://console.anthropic.com -> API Keys. BO'SH bo'lsa AI bosqichi
# o'tkazib yuboriladi va submission AI_FAILED bo'ladi (bloklanmaydi).
ANTHROPIC_API_KEY=
# Model nomi (CONTRACTS.md §1 da qotib yozilgan)
AI_MODEL=claude-sonnet-5-5
# Modelga yuboriladigan maksimal belgi (xarajat nazorati, AUDIT.md §E4)
AI_MAX_INPUT_CHARS=60000
# Bitta so'rov uchun timeout (sekund)
AI_TIMEOUT_SEC=90

# --------------------------------------------------------------- LiveKit ----
# Ekran ulashish (bir tomonlama: faqat o'qituvchi publish qiladi).
# Bo'sh bo'lsa ekran ulashish o'chadi, qolgan hamma narsa ishlaydi.
# LiveKit Cloud: wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ------------------------------------------------------------- Real-time ----
# Server tomonidan PING yuborish davri (sekund). AUDIT.md §B4.
WS_HEARTBEAT_SEC=25
# Jonli kod broadcast throttle (ms). AUDIT.md §B1.
LIVE_CODE_THROTTLE_MS=50
# Jonli kod maksimal uzunligi (belgi)
MAX_CODE_CHARS=20000

# ---------------------------------------------- Frontend (build vaqtida!) ----
# DIQQAT: NEXT_PUBLIC_* qiymatlari Next.js build'ida bundle ichiga qotib qoladi.
# O'zgartirgandan keyin `make build` (yoki `docker compose build frontend`) shart.
# REST API ildizi (Nginx orqali)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
# WebSocket ildizi. To'liq URL: ${NEXT_PUBLIC_WS_URL}/room/{pin}?ticket=...
NEXT_PUBLIC_WS_URL=ws://localhost/ws
# LiveKit WS manzili (yuqoridagi LIVEKIT_URL bilan bir xil bo'ladi)
NEXT_PUBLIC_LIVEKIT_URL=
